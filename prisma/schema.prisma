generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@map("categories")
}

model Badge {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("badges")
}

model Member {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  address      String
  phoneWa      String   @map("phone_wa")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("members")
}

model Order {
  id              String   @id @default(uuid())
  memberId        String   @map("member_id")
  subtotalAmount  Int      @map("subtotal_amount")
  ppnAmount       Int      @map("ppn_amount")
  totalAmount     Int      @map("total_amount")
  paymentStatus   String   @default("pending") @map("payment_status")
  paymentProvider String   @default("midtrans") @map("payment_provider")
  paymentRef      String?  @map("payment_ref")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([memberId])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String @map("order_id")
  productId   String @map("product_id")
  productName String @map("product_name")
  unitPrice   Int    @map("unit_price")
  quantity    Int
  lineTotal   Int    @map("line_total")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Product {
  id                 String    @id @default(uuid())
  categoryId          String?   @map("category_id")
  name               String
  shortDescription    String    @map("short_description")
  sellPrice           Int       @map("sell_price")
  strikeThroughPrice  Int?      @map("strike_through_price")
  purchasePrice       Int?      @map("purchase_price")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  category Category?     @relation(fields: [categoryId], references: [id])
  detail   ProductDetail?
  stockEntries StockLedgerEntry[]

  @@index([categoryId])
  @@map("products")
}

model StockLedgerEntry {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  type       String
  quantity   Int
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("stock_ledger_entries")
}

model ProductDetail {
  id               String    @id @default(uuid())
  productId        String    @unique @map("product_id")
  description      String
  specs            Json?
  marketplaceLinks Json?     @map("marketplace_links")
  images           Json?
  benefits         Json?
  subtitle         String?
  badge            String?
  rating           Float     @default(0)
  reviewCount      Int       @default(0) @map("review_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_details")
}

model DirectLink {
  id        String   @id @default(uuid())
  name      String   @unique
  buttons   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("direct_links")
}

model CompanyInfo {
  id            Int      @id @default(1)
  name          String
  tagline       String
  description   String
  email         String
  phone         String
  whatsapp      String
  address       String
  mapsEmbed     String   @map("maps_embed")
  socialMedia   Json     @map("social_media")
  workingHours  String   @map("working_hours")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("company_info")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  quote     String
  image     String
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model Feature {
  id          Int      @id @default(autoincrement())
  icon        String
  title       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("features")
}

model Stat {
  id        Int      @id @default(autoincrement())
  value     String
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stats")
}
